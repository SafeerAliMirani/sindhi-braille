# Riaz Hussain Memon, standard guide p.43: "if you write 4 and put a full stop
# after it, the reader will read it as 44" - because the lower-sign digits share
# cells with the punctuation. Dot 6 before the mark ends the number.
always 0. 245-6-256
always 0\x06D4 245-6-256
always 0\x060C 245-6-2
always 0, 245-6-2
always 0\x061F 245-6-236
