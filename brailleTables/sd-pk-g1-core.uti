always 1\x060C 1-6-2
always 1, 1-6-2
always 1\x061F 1-6-236
always 1? 1-6-236
always 1! 1-6-235
always 1\x061B 1-6-25
always 1; 1-6-25
always 2. 12-6-256
always 2\x06D4 12-6-256
always 2\x060C 12-6-2
always 2, 12-6-2
always 2\x061F 12-6-236
always 2? 12-6-236
always 2! 12-6-235
always 2\x061B 12-6-25
always 2; 12-6-25
always 3. 14-6-256
always 3\x06D4 14-6-256
always 3\x060C 14-6-2
always 3, 14-6-2
always 3\x061F 14-6-236
always 3? 14-6-236
always 3! 14-6-235
always 3\x061B 14-6-25
always 3; 14-6-25
always 4. 145-6-256
always 4\x06D4 145-6-256
always 4\x060C 145-6-2
always 4, 145-6-2
always 4\x061F 145-6-236
always 4? 145-6-236
always 4! 145-6-235
always 4\x061B 145-6-25
