# Cloudflare Pages headers.
#
# The page loads nothing from anywhere: no fonts, no scripts, no analytics, no
# images from a CDN. The policy below says so, which means a browser will block
# any request that ever creeps in, and a reader can verify the promise on the
# site rather than taking it on trust.

/*
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; font-src data:; connect-src 'none'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/index.html
  Cache-Control: public, max-age=0, must-revalidate
